[Unit]
Description=OpenBao for the local Authorizer app
Documentation=https://openbao.org/docs/concepts/control-groups/
After=network-online.target
Wants=network-online.target
Before=openbao-authorizer.service

[Service]
Type=simple
EnvironmentFile=%h/.config/openbao-authorizer/openbao.env
EnvironmentFile=%h/.config/openbao-authorizer/bootstrap.env
Environment=OPENBAO_BIN=%h/.local/lib/openbao-authorizer/bao
Environment=PROJECT_DIR=%h/Code/openbao-authorizer
Environment=APP_ENV_FILE=%h/.config/openbao-authorizer/app.env
Environment=PLUGIN_DIRECTORY=%h/.local/lib/openbao-authorizer/plugins
Environment=GITHUB_APP_PRIVATE_KEY_FILE=%h/.config/openbao-authorizer/github-app-private-key.pem
ExecStart=%h/.local/lib/openbao-authorizer/bao server -dev -config=%h/.config/openbao-authorizer/openbao.hcl -dev-listen-address=127.0.0.1:18200 -dev-no-store-token
StandardOutput=null
StandardError=journal
ExecStartPost=%h/.local/lib/openbao-authorizer/bootstrap-openbao.sh
Restart=on-failure
RestartSec=3s
TimeoutStartSec=90s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ReadWritePaths=%h/.config/openbao-authorizer
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=default.target
